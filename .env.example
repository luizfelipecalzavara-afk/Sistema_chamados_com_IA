# Servidor
CHAMADOIA_PORT=3101
APP_URL=http://localhost:3101

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=sua_senha_mysql
DB_NAME=chamados_ia

# Autenticação JWT - troque por uma sequência longa e aleatória no .env real
JWT_SECRET=troque_por_um_segredo_local_forte

# Google Gemini (opcional: sem chave, o sistema usa fallback local)
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
AI_CONFIDENCE_AUTO=0.75
AI_CONFIDENCE_REVIEW=0.50

# E-mail via Resend (opcional)
RESEND_API_KEY=
EMAIL_FROM=ChamadoIA <noreply@seudominio.com>
